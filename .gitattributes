# Normalise line endings: all text files use LF (Unix style), as
# required for CTAN uploads.
* text=auto eol=lf

# Files that are truly binary and must never be modified.
*.pdf binary
*.png binary
*.jpg binary
*.eps binary

# Not part of the CTAN distribution (see `git archive` / Makefile).
.gitignore     export-ignore
.gitattributes export-ignore
.github        export-ignore
Makefile       export-ignore
tests          export-ignore
