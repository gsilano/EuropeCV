% Translation completed on 01/03/2020
\ProvidesFile{ecvmt.def}[2026/10/14 europecv Maltese definitions]
% The letters h and H with stroke are not available in the standard
% 8-bit font encodings: with pdfLaTeX they are taken from the maltese
% package (\mh and \mH) if it is loaded, and drawn otherwise. Unicode
% engines (XeLaTeX and LuaLaTeX) use the characters of the current font.
\ifx\Umathchar\@undefined
  \def\ecv@hstroke#1#2{{\leavevmode\setbox\z@\hbox{#1}%
    \ooalign{#1\cr\hidewidth\raise#2\ht\z@\hbox{\vrule\@height.06\ht\z@
      \@width.7\wd\z@}\hidewidth\cr}}}
  \def\ecv@mh{\ifdefined\mh\mh\else\ecv@hstroke{h}{.72}\fi}
  \def\ecv@mH{\ifdefined\mH\mH\else\ecv@hstroke{H}{.72}\fi}
\else
  \def\ecv@mh{ħ}
  \def\ecv@mH{Ħ}
\fi
